{
  "name": "wishlist-alerts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:local-config": "wrangler deploy --config wrangler.local.jsonc",
    "migrate:local": "wrangler d1 migrations apply wishlist-alerts --local",
    "migrate:remote": "wrangler d1 migrations apply wishlist-alerts --remote"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  },
  "engines": {
    "node": ">=24"
  }
}
